# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/api_testing_tool

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Administrator Whitelist (comma-separated)
ADMIN_EMAILS=admin@example.com

# Optional Email / SMTP Configuration (for password reset OTP emails)
# If omitted, APITester uses development stream delivery with console logging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM="APITester Studio" <no-reply@apitester.io>

# Optional Two-Factor Authentication Secret Key (defaults to auto-derived key if omitted)
TWO_FACTOR_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-optional

# Optional Gemini AI Assistant API Key
GEMINI_API_KEY=your-gemini-api-key-here