# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/api_testing_tool
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Administrator Credentials (used by scripts/seedAdmin.js)
# Password MUST be at least 12 characters long with letters, numbers, and symbols
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!SecurePass

# AI Assistant Integration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery Configuration (SMTP for Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PulseAPI Studio" <your_email@gmail.com>